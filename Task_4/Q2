Question 2: Fitness Tracker Week

AIM: Dataframe creation from numpy array and type conversion

Code:
import numpy as np
import pandas as pd

data = np.array([[8200, 7.5, 40], [10400, 6.5, 55], [6100, 8.0, 20],
                 [12000, 6.0, 70], [9800, 7.0, 50], [3000, 9.0, 10],
                 [7500, 8.5, 35]])
days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']

df = pd.DataFrame(data, index=days, columns=['steps', 'sleep_hours', 'active_minutes'])

# Convert steps and active_minutes to integers
df['steps'] = df['steps'].astype(int)
df['active_minutes'] = df['active_minutes'].astype(int)

# Summary statistics
print("Summary:\n", df.describe())

# Find day with most steps and least sleep
most_steps_day = df['steps'].idxmax()
least_sleep_day = df['sleep_hours'].idxmin()

print("\nDay with most steps:", most_steps_day)
print("Day with least sleep:", least_sleep_day)


